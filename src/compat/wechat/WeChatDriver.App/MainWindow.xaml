<Window x:Class="WeChatDriver.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="微信助手" Height="640" Width="960" WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 状态栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock x:Name="StatusText" Text="状态: 启动中…" FontWeight="SemiBold" Foreground="#333"/>
            <TextBlock x:Name="VersionText" Margin="16,0,0,0" Foreground="#888"/>
            <TextBlock x:Name="BridgeText" Margin="16,0,0,0" Foreground="#888" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 主体：左会话列表 + 右消息区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <StackPanel DockPanel.Dock="Top">
                    <Button x:Name="RefreshButton" Content="刷新会话列表" Click="RefreshConversations_Click" Padding="6,4"/>
                    <TextBlock Text="选择会话后点「读取消息」" FontSize="11" Foreground="#888" Margin="0,4,0,4" TextWrapping="Wrap"/>
                </StackPanel>
                <ListBox x:Name="ConversationList" SelectionChanged="ConversationList_SelectionChanged"/>
            </DockPanel>

            <DockPanel Grid.Column="1">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                    <Button x:Name="ReadButton" Content="读取消息" Click="ReadMessages_Click" Padding="8,4" IsEnabled="False"/>
                    <Button x:Name="CopyButton" Content="复制消息" Click="CopyMessages_Click" Padding="8,4" Margin="8,0,0,0" IsEnabled="False"/>
                </StackPanel>
                <TextBox x:Name="MessagesBox" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Microsoft YaHei UI"
                         Padding="8" Background="#FAFAFA" BorderBrush="#DDD"/>
            </DockPanel>
        </Grid>

        <!-- 草稿输入框 -->
        <TextBlock Grid.Row="2" Text="草稿（回复内容）" FontSize="11" Foreground="#888" Margin="0,8,0,4"/>
        <TextBox Grid.Row="3" x:Name="DraftBox" AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                 VerticalScrollBarVisibility="Auto" Padding="8" VerticalContentAlignment="Top"
                 FontFamily="Microsoft YaHei UI" BorderBrush="#CCC"/>

        <!-- 操作按钮 + 结果 -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ResultText" Foreground="#888" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="WriteButton" Content="写入草稿" Width="90" Margin="0,0,8,0" Click="WriteDraft_Click" IsEnabled="False"/>
                <Button x:Name="SendButton" Content="发送" Width="80" Click="Send_Click" IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
